modules = ["python-3.11"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "postgresql", "tcl", "tk", "zlib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
APP_NAME = "Health is First"
APP_VERSION = "1.0.0"
DEBUG = "false"
API_V1_PREFIX = "/api/v1"
JWT_ALGORITHM = "HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES = "1440"
GEMINI_MODEL = "gemini-1.5-flash"
TTS_PROVIDER = "edge_tts"
TTS_VOICE = "ar-EG-ShakirNeural"
TTS_LANGUAGE = "ar"
MEDIA_DIR = "media"
VIDEOS_DIR = "media/videos"
AUDIO_DIR = "media/audio"
THUMBNAILS_DIR = "media/thumbnails"
BROLL_DIR = "media/broll"
VIDEO_WIDTH = "1080"
VIDEO_HEIGHT = "1920"
VIDEO_FPS = "30"
VIDEO_DURATION_MIN = "30"
VIDEO_DURATION_MAX = "60"
CONTENT_LANGUAGE = "ar"
CHANNEL_NAME = "Health is First"
CHANNEL_NICHE = "health and wellness"
RATE_LIMIT_PER_MINUTE = "60"
COLLECT_TRENDS_INTERVAL = "3600"
GENERATE_CONTENT_INTERVAL = "7200"
LOG_LEVEL = "INFO"
LOG_FILE = "logs/app.log"
REDIS_URL = "redis://localhost:6379/0"
CELERY_BROKER_URL = "redis://localhost:6379/0"
CELERY_RESULT_BACKEND = "redis://localhost:6379/1"
EXTERNAL_DATABASE_URL = "postgresql://gamalalmaqtary:wjgw2u0I4NOXkWIWu87zLQOMvVtVmuTa@dpg-d81fss7aqgkc73aumg90-a/health_is_first_db"
