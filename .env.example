# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Health is First - Environment Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# App
APP_NAME="Health is First"
DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/health_is_first
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/health_is_first

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# AI - Google Gemini
# Get from: https://makersuite.google.com/app/apikey
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# YouTube API
# Get from: https://console.cloud.google.com/
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
YOUTUBE_REFRESH_TOKEN=your-youtube-refresh-token
YOUTUBE_CHANNEL_ID=your-channel-id

# TTS Settings
TTS_PROVIDER=edge_tts
TTS_VOICE=ar-EG-ShakirNeural
TTS_LANGUAGE=ar

# Video Settings
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_DURATION_MIN=30
VIDEO_DURATION_MAX=60

# Content
CONTENT_LANGUAGE=ar
CHANNEL_NAME="Health is First"
CHANNEL_NICHE=health and wellness

# Paths
MEDIA_DIR=media
VIDEOS_DIR=media/videos
AUDIO_DIR=media/audio
THUMBNAILS_DIR=media/thumbnails
BROLL_DIR=media/broll

# Scheduler
COLLECT_TRENDS_INTERVAL=3600
GENERATE_CONTENT_INTERVAL=7200

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
